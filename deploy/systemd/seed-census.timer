# Census pipeline (optional; deploy.sh does not install it).
#   install -m 0755 deploy/seed-census.sh   /usr/local/bin/seed-census
#   install -m 0755 deploy/seed-stable.py   /usr/local/bin/seed-stable
#   install -m 0755 deploy/seed-publish.sh  /usr/local/bin/seed-publish
#   install -m 0600 deploy/seed-publish.default.example /etc/default/seed-publish  (then edit)
#   cp deploy/systemd/seed-*.{service,timer} /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now seed-census.timer seed-publish.timer
[Unit]
Description=Hourly census of the reachable BLAKE2b network

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
AccuracySec=1min
# Catch up after downtime so the adoption curve does not silently gap.
Persistent=true

[Install]
WantedBy=timers.target
